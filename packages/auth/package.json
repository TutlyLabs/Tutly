{
  "name": "@tutly/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./src/permissions.ts"
    },
    "./access-control": {
      "types": "./src/access-control.ts",
      "default": "./src/access-control.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./enrich-session": {
      "types": "./src/enrich-session.ts",
      "default": "./src/enrich-session.ts"
    },
    "./api-key-session": {
      "types": "./src/api-key-session.ts",
      "default": "./src/api-key-session.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./mcp": {
      "types": "./src/mcp.ts",
      "default": "./src/mcp.ts"
    }
  },
  "scripts": {
    "auth:generate-schema": "better-auth generate --config better-auth.config.ts --output ../db/prisma/schema.prisma",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.4.22",
    "@tutly/db": "workspace:*",
    "better-auth": "1.4.22"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@tutly/eslint-config": "workspace:*",
    "@tutly/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
