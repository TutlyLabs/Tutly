{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-lock.yaml",
    "tooling/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/__tests__/**"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "lib/**",
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BUILD_TARGET",
        "FRONTEND_URL",
        "BACKEND_URL",
        "VERCEL_URL",
        "VITE_API_URL",
        "MODE",
        "GOOGLE_CLIENT_ID",
        "GITHUB_CLIENT_ID",
        "ZOOM_CLIENT_ID",
        "AWS_BUCKET_NAME",
        "AWS_BUCKET_REGION",
        "AWS_ENDPOINT",
        "AWS_S3_URL",
        "AWS_S3_PUBLIC_URL",
        "STORAGE_S3_ENDPOINT",
        "STORAGE_S3_REGION",
        "STORAGE_S3_BUCKET",
        "STORAGE_S3_FORCE_PATH_STYLE",
        "VIDEO_WORKER_URL",
        "TEST_RUNNER_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*"
      ]
    },
    "format": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        ".cache/.prettiercache"
      ],
      "outputLogs": "new-only"
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "PORT",
    "PORT_WORKER",
    "REDIS_URL",
    "WORK_DIR",
    "CONCURRENCY",
    "FFMPEG_PATH",
    "FFPROBE_PATH",
    "LOG_LEVEL",
    "APP_SERVER_IP",
    "CLOUDFLARE_ZONE_ID",
    "AUTH_SECRET",
    "AWS_ACCESS_KEY",
    "AWS_SECRET_KEY",
    "BETTER_AUTH_SECRET",
    "BULL_BOARD_USER",
    "CLOUDFLARE_API_TOKEN",
    "COOLIFY_TOKEN",
    "FIREBASE_SERVICE_ACCOUNT_JSON",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_SECRET",
    "NPM_TOKEN",
    "RESEND_API_KEY",
    "SERVICE_CONNECTION_ENCRYPTION_KEY",
    "STORAGE_S3_ACCESS_KEY",
    "STORAGE_S3_SECRET_KEY",
    "TEST_RUNNER_SECRET",
    "TUTLY_VSCODE_SECRET",
    "VIDEO_WORKER_SECRET",
    "WORKER_SECRET",
    "WORKSPACE_AGENT_SECRET",
    "ZOOM_CLIENT_SECRET",
    "SANDPACK_BUNDLER_SRC",
    "ANDROID_KEYSTORE_BASE64",
    "ANDROID_KEYSTORE_PASSWORD",
    "ANDROID_KEY_ALIAS",
    "ANDROID_KEY_PASSWORD"
  ]
}
