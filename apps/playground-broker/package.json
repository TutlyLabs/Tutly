{
  "name": "playground-broker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --import tsx --env-file=.env src/index.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@tutly/db": "workspace:*",
    "@tutly/playground-protocol": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tutly/eslint-config": "workspace:*",
    "@tutly/typescript-config": "workspace:*",
    "@types/node": "^25.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.2",
    "typescript": "5.9.3"
  }
}
